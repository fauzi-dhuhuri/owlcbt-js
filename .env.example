# ==============================================================================
# OwlCBT - Konfigurasi Lingkungan (Environment Variables)
# ==============================================================================
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
# cp .env.example .env

# 1. KONEKSI DATABASE POSTGRESQL (Wajib)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=public
#
# Contoh untuk Instalasi PostgreSQL Lokal di Server Sekolah / Laptop:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/owlcbt_db?schema=public"

# Contoh untuk PostgreSQL Cloud (Supabase, Neon, Railway, dsb.):
# DATABASE_URL="postgresql://postgres:password_kamu@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. PENGATURAN NODE & PORT (Opsional)
NODE_ENV="development"
PORT=3000
